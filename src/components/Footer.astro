---
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/booking', label: 'Booking' },
  { href: '/contact', label: 'Contact' },
];

const serviceLinks = [
  'Emergency Repairs', 'Bathroom Renovations', 'Commercial Plumbing',
  'Hot Water Systems', 'Drain Cleaning', 'Gas Fitting',
];
---

<footer style="background: var(--color-navy);">
  <div class="h-[2px] w-full" style="background: linear-gradient(90deg, var(--color-blue), var(--color-blue-light), var(--color-blue));"></div>

  <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
    <div class="pt-20 pb-16 lg:pt-24 lg:pb-20">
      <!-- Brand -->
      <div class="mb-12 lg:mb-14">
        <a href="/" class="inline-flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-[6px] flex items-center justify-center" style="background: var(--color-blue);">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.66-5.66a8 8 0 1111.31 0l-5.65 5.66zm0 0L12 21"/></svg>
          </div>
          <div>
            <span class="text-[1rem] font-bold tracking-[0.04em] uppercase" style="font-family: var(--font-display); color: #fff;">Hartley & Co</span>
            <span class="block text-[0.5625rem] font-semibold tracking-[0.14em] uppercase" style="color: var(--color-blue-light);">Plumbing</span>
          </div>
        </a>
        <p class="mt-3 text-[0.875rem] leading-relaxed max-w-sm" style="color: rgba(148, 163, 184, 0.8);">
          Trusted by Sydney CBD homes and businesses since 2003. Licensed, insured, and guaranteed — so your plumbing is always in safe hands.
        </p>
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
        <div>
          <h4 class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] mb-5" style="color: var(--color-blue-light); font-family: var(--font-display);">Navigate</h4>
          <ul class="space-y-3">
            {links.map(link => (
              <li>
                <a href={link.href} class="text-[0.8125rem] transition-colors duration-300 hover:text-white" style="color: rgba(148, 163, 184, 0.75);">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] mb-5" style="color: var(--color-blue-light); font-family: var(--font-display);">Services</h4>
          <ul class="space-y-3">
            {serviceLinks.map(service => (
              <li>
                <a href="/services" class="text-[0.8125rem] transition-colors duration-300 hover:text-white" style="color: rgba(148, 163, 184, 0.75);">
                  {service}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h4 class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] mb-5" style="color: var(--color-blue-light); font-family: var(--font-display);">Contact</h4>
          <ul class="space-y-3 text-[0.8125rem]" style="color: rgba(148, 163, 184, 0.75);">
            <li>78 Pitt Street<br>Sydney NSW 2000</li>
            <li><a href="tel:0412555178" class="transition-colors duration-300 hover:text-white" style="color: rgba(148, 163, 184, 0.75);">0412 555 178</a></li>
            <li><a href="mailto:info@hartleyplumbing.com.au" class="transition-colors duration-300 hover:text-white break-all" style="color: rgba(148, 163, 184, 0.75);">info@hartleyplumbing.com.au</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-[0.6875rem] font-bold uppercase tracking-[0.14em] mb-5" style="color: var(--color-blue-light); font-family: var(--font-display);">Hours</h4>
          <ul class="space-y-2.5 text-[0.8125rem]">
            <li class="flex justify-between" style="color: rgba(148, 163, 184, 0.75);">
              <span>Mon – Fri</span>
              <span class="font-medium text-white">7am – 6pm</span>
            </li>
            <li class="flex justify-between" style="color: rgba(148, 163, 184, 0.75);">
              <span>Saturday</span>
              <span class="font-medium text-white">8am – 2pm</span>
            </li>
            <li class="flex justify-between" style="color: rgba(148, 163, 184, 0.75);">
              <span>Sunday</span>
              <span class="font-medium" style="color: var(--color-amber);">Emergency Only</span>
            </li>
          </ul>
          <div class="mt-5 pt-4" style="border-top: 1px solid rgba(255,255,255,0.06);">
            <a href="/booking" class="btn-primary !py-2.5 !px-5 !text-[0.75rem] w-full">Book a Plumber</a>
          </div>
        </div>
      </div>
    </div>

    <div class="py-7 flex flex-col md:flex-row justify-between items-center gap-3" style="border-top: 1px solid rgba(255,255,255,0.06);">
      <p class="text-[0.6875rem]" style="color: rgba(148, 163, 184, 0.5);">
        &copy; 2026 Hartley & Co Plumbing. All rights reserved. ABN 12 345 678 901
      </p>
      <p class="text-[0.6875rem]" style="color: rgba(148, 163, 184, 0.5);">
        Licensed NSW Plumbers &middot; 78 Pitt Street, Sydney NSW 2000
      </p>
    </div>
  </div>
</footer>
