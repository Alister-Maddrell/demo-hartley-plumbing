---
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="bg-primary-dark text-white relative overflow-hidden">
  <!-- Top decorative border -->
  <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary via-accent to-primary"></div>
  <!-- Subtle decorative gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-white/[0.02] to-transparent pointer-events-none"></div>
  <!-- Blueprint grid texture -->
  <div class="absolute inset-0 opacity-[0.02]" style="background-image: radial-gradient(circle, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 32px 32px;"></div>

  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 pt-16 pb-8 relative">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <div class="flex items-center gap-2.5 mb-5">
          <div class="w-9 h-9 bg-white/10 rounded-lg flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.66-5.66a8 8 0 1111.31 0l-5.65 5.66zm0 0L12 21"/></svg>
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-bold text-[17px] tracking-tight">Hartley & Co</span>
            <span class="text-blue-300/60 text-[11px] font-medium tracking-wide uppercase">Plumbing</span>
          </div>
        </div>
        <p class="text-blue-200/70 text-sm leading-relaxed max-w-xs">
          Sydney CBD's trusted plumbing experts since 2003. Licensed, insured, and available 24/7 for emergency repairs.
        </p>
        <div class="flex gap-3 mt-5">
          <a href="#" class="w-9 h-9 bg-white/10 hover:bg-accent rounded-lg flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" aria-label="Facebook">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 bg-white/10 hover:bg-accent rounded-lg flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" aria-label="Instagram">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="w-9 h-9 bg-white/10 hover:bg-accent rounded-lg flex items-center justify-center transition-all duration-300 hover:-translate-y-0.5" aria-label="Google">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-xs font-semibold tracking-widest uppercase text-blue-300/50 mb-5">Navigation</h3>
        <ul class="space-y-3">
          {links.map(link => (
            <li>
              <a href={link.href} class="text-blue-100/80 hover:text-white text-sm transition-colors inline-flex items-center gap-1.5 group">
                <svg class="w-3 h-3 text-blue-400/40 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Details -->
      <div>
        <h3 class="text-xs font-semibold tracking-widest uppercase text-blue-300/50 mb-5">Contact</h3>
        <ul class="space-y-3 text-sm">
          <li>
            <a href="tel:0412555178" class="text-blue-100/80 hover:text-white transition-colors flex items-center gap-2.5">
              <svg class="w-4 h-4 text-blue-400/50 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              0412 555 178
            </a>
          </li>
          <li>
            <a href="mailto:info@hartleyplumbing.com.au" class="text-blue-100/80 hover:text-white transition-colors flex items-center gap-2.5">
              <svg class="w-4 h-4 text-blue-400/50 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              info@hartleyplumbing.com.au
            </a>
          </li>
          <li class="flex items-start gap-2.5 text-blue-100/80">
            <svg class="w-4 h-4 text-blue-400/50 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            78 Pitt Street,<br />Sydney NSW 2000
          </li>
        </ul>
      </div>

      <!-- Hours -->
      <div>
        <h3 class="text-xs font-semibold tracking-widest uppercase text-blue-300/50 mb-5">Business Hours</h3>
        <ul class="space-y-2 text-sm text-blue-100/80">
          <li class="flex justify-between gap-4">
            <span>Mon – Fri</span>
            <span class="text-white font-medium">7am – 6pm</span>
          </li>
          <li class="flex justify-between gap-4">
            <span>Saturday</span>
            <span class="text-white font-medium">8am – 2pm</span>
          </li>
          <li class="flex justify-between gap-4">
            <span>Sunday</span>
            <span class="text-accent font-medium">Emergency Only</span>
          </li>
        </ul>
        <div class="mt-5 pt-4 border-t border-white/10">
          <p class="text-xs text-blue-300/50">ABN: 12 345 678 901</p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 mt-12 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-xs text-blue-300/40">&copy; 2026 Hartley & Co Plumbing. All rights reserved.</p>
      <p class="text-xs text-blue-300/40">Licensed NSW Plumbers &middot; Est. 2003</p>
    </div>
  </div>
</footer>
