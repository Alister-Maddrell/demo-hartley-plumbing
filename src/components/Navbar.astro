---
const currentPath = Astro.url.pathname;
const links = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Booking', href: '/booking' },
  { name: 'Contact', href: '/contact' },
];
---

<!-- Top Info Bar -->
<div class="nav-topbar hidden md:block">
  <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
    <div class="flex items-center justify-between h-9">
      <div class="flex items-center gap-5">
        <a href="tel:0412555178" class="flex items-center gap-1.5">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          0412 555 178
        </a>
        <span style="color: rgba(255,255,255,0.2);">|</span>
        <a href="mailto:info@hartleyplumbing.com.au" class="flex items-center gap-1.5">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          info@hartleyplumbing.com.au
        </a>
      </div>
      <div class="flex items-center gap-1.5 text-[0.6875rem]" style="color: rgba(255,255,255,0.5);">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Mon–Fri 7am–6pm · Sat 8am–2pm · <span style="color: var(--color-amber);">24/7 Emergency</span>
      </div>
    </div>
  </div>
</div>

<!-- Main Navigation -->
<nav class="nav-main" id="nav-main">
  <div class="nav-inner">
    <!-- Logo -->
    <a href="/" class="nav-logo">
      <div class="nav-logo-icon">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.66-5.66a8 8 0 1111.31 0l-5.65 5.66zm0 0L12 21"/></svg>
      </div>
      <div>
        <div class="nav-logo-text">Hartley & Co</div>
        <div class="nav-logo-sub">Plumbing</div>
      </div>
    </a>

    <!-- Desktop Links -->
    <div class="nav-links hidden md:flex">
      {links.map(link => (
        <a href={link.href} class={`nav-link ${currentPath === link.href ? 'active' : ''}`}>
          {link.name}
        </a>
      ))}
    </div>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a href="tel:0412555178" class="nav-phone">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        0412 555 178
      </a>
      <a href="/booking" class="nav-cta">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Book a Plumber
      </a>
    </div>

    <!-- Mobile Burger -->
    <button class="nav-burger md:hidden" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="nav-mobile md:hidden" id="mobile-menu">
    <div class="nav-mobile-inner">
      {links.map(link => (
        <a href={link.href} class="nav-mobile-link">{link.name}</a>
      ))}
      <div class="nav-mobile-divider"></div>
      <a href="tel:0412555178" class="nav-mobile-link" style="color: var(--color-navy); font-weight: 700;">
        <span class="flex items-center gap-2">
          <svg class="w-4 h-4" style="color: var(--color-amber);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Emergency: 0412 555 178
        </span>
      </a>
      <a href="/booking" class="nav-cta nav-cta-mobile">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Book a Plumber
      </a>
    </div>
  </div>
</nav>
