---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
---

<!-- Click-to-Call Sticky Bar (Mobile Only) -->
<div class="fixed top-0 left-0 right-0 z-[60] md:hidden bg-gradient-to-r from-navy-900 via-navy-800 to-navy-900">
  <a href="tel:0412555178" class="flex items-center justify-center gap-2 h-11 text-white text-sm font-semibold tracking-wide">
    <span class="relative flex h-2.5 w-2.5 shrink-0">
      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-copper-400 opacity-60"></span>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-copper-400"></span>
    </span>
    <svg class="w-4 h-4 text-copper-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    Emergency? Call 0412 555 178
  </a>
</div>

<header class="fixed top-11 md:top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
  <!-- Background layers -->
  <div class="absolute inset-0 bg-white/90 backdrop-blur-xl border-b border-black/[0.04]" id="navbar-bg"></div>

  <nav class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="flex items-center justify-between h-[76px]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative w-10 h-10 bg-gradient-to-br from-navy-800 to-navy-900 rounded-xl flex items-center justify-center group-hover:scale-105 transition-transform shadow-[0_2px_8px_rgba(12,27,46,0.3)]">
          <!-- Pipe wrench icon -->
          <svg class="w-5 h-5 text-copper-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.66-5.66a8 8 0 1111.31 0l-5.65 5.66zm0 0L12 21"/></svg>
          <!-- Copper corner accent -->
          <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-copper-500 rounded-tr-xl rounded-bl-lg"></div>
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-navy-900 font-extrabold text-lg tracking-tight">Hartley & Co</span>
          <span class="text-copper-500 text-[10px] font-bold tracking-[0.2em] uppercase mt-0.5">Plumbing</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1">
        {links.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-5 py-2.5 rounded-xl text-[14px] font-semibold transition-all relative',
              currentPath === link.href
                ? 'text-copper-600 bg-copper-50'
                : 'text-navy-600 hover:text-copper-600 hover:bg-copper-50/50'
            ]}
          >
            {link.label}
            {currentPath === link.href && (
              <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full bg-copper-500"></span>
            )}
          </a>
        ))}
      </div>

      <!-- CTA Button -->
      <a
        href="tel:0412555178"
        class="hidden md:inline-flex items-center gap-2.5 bg-gradient-to-r from-copper-500 to-copper-600 hover:from-copper-600 hover:to-copper-700 text-white text-sm font-bold pl-4 pr-5 py-2.5 rounded-full shadow-[var(--shadow-copper)] hover:-translate-y-0.5 transition-all"
      >
        <div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        0412 555 178
      </a>

      <!-- Mobile Menu Button -->
      <button id="menu-toggle" class="md:hidden p-2 -mr-2 text-navy-700 hover:text-copper-600 rounded-lg hover:bg-copper-50 transition-colors" aria-label="Toggle menu" aria-expanded="false">
        <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-6 -mx-1">
      <div class="bg-bg-light rounded-2xl p-3 mb-4">
        <div class="flex flex-col gap-1">
          {links.map(link => (
            <a
              href={link.href}
              class:list={[
                'px-4 py-3 rounded-xl text-[15px] font-semibold transition-all',
                currentPath === link.href
                  ? 'bg-white text-copper-600 shadow-[var(--shadow-soft)]'
                  : 'text-navy-700 hover:bg-white hover:text-copper-600'
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>
      <a
        href="tel:0412555178"
        class="flex items-center justify-center gap-2.5 bg-gradient-to-r from-copper-500 to-copper-600 text-white font-bold px-6 py-3.5 rounded-full shadow-[var(--shadow-copper)] transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call Now: 0412 555 178
      </a>
    </div>
  </nav>
</header>

<!-- Spacer -->
<div class="h-[120px] md:h-[76px]"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Navbar background on scroll
  const navbar = document.getElementById('navbar');
  const navbarBg = document.getElementById('navbar-bg');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbarBg?.classList.add('shadow-[0_4px_20px_rgba(0,0,0,0.06)]');
    } else {
      navbarBg?.classList.remove('shadow-[0_4px_20px_rgba(0,0,0,0.06)]');
    }
  });
</script>
