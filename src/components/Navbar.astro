---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact' },
];
---

<!-- Click-to-Call Sticky Bar (Mobile Only) -->
<div class="fixed top-0 left-0 right-0 z-[60] md:hidden bg-[#1E3A5F]">
  <a href="tel:0412555178" class="flex items-center justify-center gap-2 h-10 text-white text-sm font-semibold tracking-wide">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
    Emergency? Call Now — 0412 555 178
  </a>
</div>

<header class="fixed top-10 md:top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-xl border-b border-gray-900/5" id="navbar">
  <nav class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
    <div class="flex items-center justify-between h-[72px]">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 bg-primary rounded-lg flex items-center justify-center group-hover:scale-105 transition-transform">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.66-5.66a8 8 0 1111.31 0l-5.65 5.66zm0 0L12 21"/></svg>
        </div>
        <div class="flex flex-col leading-none">
          <span class="text-primary font-bold text-[17px] tracking-tight">Hartley & Co</span>
          <span class="text-text-muted text-[11px] font-medium tracking-wide uppercase">Plumbing</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-1">
        {links.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-lg text-[15px] font-medium transition-all',
              currentPath === link.href
                ? 'text-primary bg-primary/5'
                : 'text-text-secondary hover:text-primary hover:bg-gray-50'
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA Button -->
      <a
        href="tel:0412555178"
        class="hidden md:inline-flex items-center gap-2.5 bg-accent hover:bg-accent-hover text-white text-sm font-semibold pl-4 pr-5 py-2.5 rounded-full shadow-[0_2px_8px_rgba(249,115,22,0.3)] hover:shadow-[0_4px_16px_rgba(249,115,22,0.4)] hover:-translate-y-0.5 transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        0412 555 178
      </a>

      <!-- Mobile Menu Button -->
      <button id="menu-toggle" class="md:hidden p-2 -mr-2 text-text-secondary hover:text-primary rounded-lg hover:bg-gray-50 transition-colors" aria-label="Toggle menu">
        <svg id="menu-open-icon" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="menu-close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-5 -mx-1">
      <div class="flex flex-col gap-1 mb-4">
        {links.map(link => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-3 rounded-xl text-[15px] font-medium transition-all',
              currentPath === link.href
                ? 'bg-primary/5 text-primary'
                : 'text-text-secondary hover:bg-gray-50 hover:text-primary'
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
      <a
        href="tel:0412555178"
        class="flex items-center justify-center gap-2.5 bg-accent hover:bg-accent-hover text-white font-semibold px-6 py-3 rounded-full shadow-[0_2px_8px_rgba(249,115,22,0.3)] transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call Now: 0412 555 178
      </a>
    </div>
  </nav>
</header>

<!-- Spacer for fixed navbar + mobile sticky bar -->
<div class="h-[112px] md:h-[72px]"></div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Navbar shadow on scroll
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      navbar?.classList.add('shadow-[0_1px_3px_rgba(0,0,0,0.05)]');
      navbar?.classList.remove('border-b', 'border-gray-900/5');
    } else {
      navbar?.classList.remove('shadow-[0_1px_3px_rgba(0,0,0,0.05)]');
      navbar?.classList.add('border-b', 'border-gray-900/5');
    }
  });
</script>
