---
const currentPath = Astro.url.pathname;
const links = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'Contact', href: '/contact' },
];
---

<div class="nav-wrap" id="nav-wrap">
  <nav class="nav-bar" id="main-nav">
    <div class="nav-inner">
      <a href="/" class="nav-logo">
        <div class="nav-logo-icon">
          <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.66-5.66a8 8 0 1111.31 0l-5.65 5.66zm0 0L12 21"/></svg>
        </div>
        <div>
          <div class="nav-logo-text">Hartley & Co</div>
          <div class="nav-logo-sub">Plumbing</div>
        </div>
      </a>

      <div class="nav-links hidden md:flex">
        {links.map(link => (
          <a href={link.href} class={`nav-link ${currentPath === link.href ? 'active' : ''}`}>
            {link.name}
          </a>
        ))}
      </div>

      <div class="hidden md:flex items-center gap-3">
        <a href="tel:0412555178" class="nav-link" style="color: var(--color-amber); font-weight: 600;">
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            0412 555 178
          </span>
        </a>
        <a href="/contact#booking" class="nav-cta">
          Book a Plumber
        </a>
      </div>

      <button class="nav-burger md:hidden" id="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
        <span class="burger-line"></span>
        <span class="burger-line"></span>
        <span class="burger-line"></span>
      </button>
    </div>

    <div class="nav-mobile md:hidden" id="mobile-menu">
      <div class="nav-mobile-inner">
        {links.map(link => (
          <a href={link.href} class="nav-mobile-link">{link.name}</a>
        ))}
        <div class="nav-mobile-divider"></div>
        <a href="tel:0412555178" class="nav-mobile-link" style="color: var(--color-amber);">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Emergency: 0412 555 178
          </span>
        </a>
        <a href="/contact#booking" class="nav-cta nav-cta-mobile">
          Book a Plumber
        </a>
      </div>
    </div>
  </nav>
</div>
