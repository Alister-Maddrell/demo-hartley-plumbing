  <style>
    /* Responsive overrides */
    @media (max-width: 1023px) {
      /* Why Choose Us and Service Area: stack to single column */
      section:nth-of-type(4) > div > div,
      section:nth-of-type(6) > div > div {
        grid-template-columns: 1fr !important;
        gap: 2.5rem !important;
      }
    }

    @media (max-width: 767px) {
      /* Trust badges: 2 columns */
      section:nth-of-type(2) > div > div {
        grid-template-columns: repeat(2, 1fr) !important;
      }
      /* Services and testimonials: single column */
      section:nth-of-type(3) > div > div:last-child,
      section:nth-of-type(5) > div > div:last-child {
        grid-template-columns: 1fr !important;
      }
      /* Hero stats: 2x2 grid */
      section:first-of-type [style*="grid-template-columns: repeat(4"] {
        grid-template-columns: repeat(2, 1fr) !important;
      }
    }
  </style>
