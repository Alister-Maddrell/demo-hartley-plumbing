---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const services = [
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>',
    title: '24/7 Emergency Plumbing',
    description: 'Burst pipe flooding your kitchen at 2am? Your emergency plumber arrives in under 60 minutes across Sydney CBD and inner suburbs.',
    tag: 'URGENT',
    tagColor: 'var(--color-amber)',
    num: '01',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>',
    title: 'Bathroom Renovations',
    description: 'Full design-to-build renovations with licensed plumbing, waterproofing, and tiling — delivered on time, on budget, and backed by warranty.',
    tag: 'POPULAR',
    tagColor: 'var(--color-blue)',
    num: '02',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>',
    title: 'Commercial Plumbing',
    description: 'Scheduled maintenance, new fit-outs, and compliance work — so your office, restaurant, or retail space stays open and worry-free.',
    tag: 'B2B',
    tagColor: 'var(--color-navy)',
    num: '03',
  },
];

const testimonials = [
  {
    quote: "Our hot water system died on a Sunday night. Hartley & Co had a plumber at our Darlinghurst apartment within 45 minutes and replaced the entire unit by Monday morning. Honestly lifesavers.",
    name: 'Sarah M.',
    location: 'Darlinghurst',
  },
  {
    quote: "We manage three office buildings near Martin Place and Hartley & Co handles all our plumbing maintenance. Three years running, not a single missed appointment.",
    name: 'James T.',
    location: 'Martin Place',
  },
  {
    quote: "Hired them for a full bathroom reno in our Surry Hills terrace. They gutted and rebuilt the whole thing in under three weeks — new tiling, waterproofing, the lot. The result is stunning.",
    name: 'David & Lisa K.',
    location: 'Surry Hills',
  },
];

const stats = [
  { number: '2,400+', label: 'Jobs Completed' },
  { number: '20+', label: 'Years in Sydney' },
  { number: '60', label: 'Min Response Time' },
  { number: '4.9', label: 'Google Rating' },
];

const badges = [
  { icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>', label: 'Fully Licensed & Insured' },
  { icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>', label: '24/7 Emergency Callouts' },
  { icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>', label: '4.9★ Google Rating' },
  { icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>', label: 'Lifetime Guarantee' },
];
---

<Layout
  title="Sydney CBD Plumber | 24/7 Emergency | Hartley & Co"
  description="Burst pipe or blocked drain in Sydney CBD? Hartley & Co plumbers arrive in under 60 minutes, 24/7. Licensed, insured, guaranteed. Book your plumber today."
>
  <Navbar />

  <!-- ═══ HERO ═══ -->
  <section class="relative overflow-hidden min-h-[100dvh] flex flex-col justify-center" style="background: var(--color-navy);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(0deg, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative max-w-[1200px] w-full mx-auto px-6 lg:px-10 pt-28 pb-16">
      <div class="max-w-2xl">
        <!-- Availability -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-[3px] mb-7 reveal" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.08);">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-60" style="background: #34D399;"></span>
            <span class="relative inline-flex rounded-full h-2 w-2" style="background: #34D399;"></span>
          </span>
          <span class="text-[0.75rem] font-semibold text-white tracking-wide">Available 24/7 for emergencies</span>
        </div>

        <h1 class="reveal stagger-1" style="color: #F8FAFC; line-height: 1.05; text-shadow: 0 2px 20px rgba(0,0,0,0.5);">
          Burst Pipe?<br />
          We're There<br />
          <span style="color: var(--color-blue-light);">in 60 Minutes</span>
        </h1>

        <div class="w-16 h-[2px] mt-6 mb-7 reveal stagger-2" style="background: var(--color-blue);"></div>

        <p class="text-[1.0625rem] md:text-[1.125rem] leading-[1.75] max-w-[540px] reveal stagger-2" style="color: rgba(203, 213, 225, 0.9);">
          Whether it's a 3am emergency or a blocked drain before guests arrive, your problem gets fixed fast — by licensed, insured plumbers who get it right the first time. Serving Sydney CBD and all inner suburbs since 2003.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 reveal stagger-3">
          <a href="/contact#booking" class="btn-primary">
            Book a Plumber Now
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <a href="/services" class="btn-outline-light">
            See What We Fix
          </a>
        </div>

        <div class="mt-10 flex items-center gap-6 reveal stagger-4">
          {stats.map((stat, i) => (
            <Fragment>
              {i > 0 && <div class="w-px h-8" style="background: rgba(255,255,255,0.1);"></div>}
              <div class="text-center sm:text-left">
                <span class="text-[1.5rem] font-bold tracking-[-0.02em]" style="color: var(--color-blue-light); font-family: var(--font-display);">{stat.number}</span>
                <span class="block text-[0.625rem] font-medium uppercase tracking-[0.08em] mt-0.5" style="color: rgba(148,163,184,0.7);">{stat.label}</span>
              </div>
            </Fragment>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TRUST BADGES ═══ -->
  <section class="py-5" style="background: var(--color-slate); border-bottom: 1px solid var(--color-border);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        {badges.map((badge, i) => (
          <div class={`reveal stagger-${i + 1} trust-badge flex items-center gap-3`}>
            <div class="w-9 h-9 rounded-[3px] flex items-center justify-center shrink-0" style="background: var(--color-blue-subtle); color: var(--color-blue); border: 1px solid var(--color-blue-pale);" set:html={badge.icon} />
            <p class="font-semibold text-[0.8125rem] leading-tight" style="color: var(--color-navy);">{badge.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SERVICES ═══ -->
  <section id="services" class="py-20 md:py-28" style="background: var(--color-white);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 md:mb-20 gap-4">
        <div>
          <div class="section-label mb-3 reveal">Services</div>
          <h2 class="reveal stagger-1">Problems Solved,<br class="hidden sm:block"> Guaranteed</h2>
          <p class="mt-4 text-[0.9375rem] leading-[1.7] max-w-lg reveal stagger-2" style="color: var(--color-text-secondary);">
            From emergency callouts to full renovations, every job is backed by a lifetime workmanship guarantee.
          </p>
        </div>
        <a href="/services" class="reveal link-arrow inline-flex items-center gap-2 text-[0.8125rem] font-semibold" style="color: var(--color-blue);">
          View all 6 services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <a href="/contact#booking" class={`reveal stagger-${i + 1} card card-blue group p-7`}>
            <div class="flex items-center justify-between mb-5">
              <div class="w-10 h-10 rounded-[3px] flex items-center justify-center" style="background: var(--color-blue-subtle); color: var(--color-blue); border: 1px solid var(--color-blue-pale);" set:html={service.icon} />
              <span class="text-[0.5625rem] font-bold tracking-[0.12em] uppercase px-2 py-1 rounded-[2px]" style={`background: ${service.tagColor}; color: #fff;`}>{service.tag}</span>
            </div>
            <h3 class="text-[1.05rem] font-bold mb-2.5" style="color: var(--color-navy);">{service.title}</h3>
            <p class="text-[0.8125rem] leading-[1.7] mb-5" style="color: var(--color-text-secondary);">{service.description}</p>
            <span class="link-arrow inline-flex items-center gap-2 text-[0.8125rem] font-semibold" style="color: var(--color-blue);">
              Book to Discuss
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ WHY CHOOSE US ═══ -->
  <section class="relative py-20 md:py-28 overflow-hidden" style="background: var(--color-navy);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(0deg, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">
        <div>
          <div class="section-label mb-3 reveal" style="color: var(--color-blue-light);">
            <span style="color: var(--color-blue-light);">Why Hartley & Co</span>
          </div>
          <h2 class="reveal stagger-1 mb-5" style="color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,0.3);">Why Sydney Trusts Hartley & Co</h2>
          <p class="text-[1rem] leading-[1.75] mb-8 reveal stagger-2" style="color: rgba(203, 213, 225, 0.85);">
            You deserve a plumber who shows up on time, charges what they quoted, and fixes it right the first time. Third-generation tradespeople, no shortcuts, no surprises.
          </p>

          <div class="space-y-5">
            {[
              { title: 'At Your Door in 60 Minutes', desc: 'No waiting, no uncertainty. Your nearest plumber is dispatched the moment you call — day or night.' },
              { title: 'Know the Price Before Work Starts', desc: 'You get a written quote upfront — so there are no surprises on your invoice. No hidden fees, ever.' },
              { title: "Guaranteed — or You Don't Pay", desc: "If anything we fixed breaks down, you're covered. We come back and repair it free of charge. Full stop." },
            ].map((item, i) => (
              <div class={`reveal stagger-${i + 2} flex items-start gap-4`}>
                <div class="w-10 h-10 rounded-[3px] flex items-center justify-center shrink-0 mt-0.5" style="background: rgba(37, 99, 235, 0.12); border: 1px solid rgba(59, 130, 246, 0.2);">
                  <svg class="w-4 h-4" style="color: var(--color-blue-light);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                <div>
                  <p class="text-[0.875rem] font-bold text-white mb-1">{item.title}</p>
                  <p class="text-[0.8125rem] leading-relaxed" style="color: rgba(148, 163, 184, 0.8);">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-10 reveal stagger-5">
            <a href="/contact#booking" class="btn-primary">
              Book Your Free Quote
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
          </div>
        </div>

        <div class="hidden lg:block reveal stagger-3">
          <div class="relative rounded-[3px] overflow-hidden" style="box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
            <img src="https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=700&h=900&fit=crop" alt="Professional plumber with tools ready for work" class="w-full object-cover aspect-[3/4]" loading="lazy" />
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(12,26,46,0.4), transparent);"></div>
          </div>
          <div class="absolute -left-4 bottom-12 rounded-[3px] p-5 shadow-lg" style="background: var(--color-blue);">
            <p class="text-3xl font-bold leading-none text-white" style="font-family: var(--font-display);">20+</p>
            <p class="text-[0.625rem] font-semibold mt-1 tracking-[0.1em] uppercase" style="color: rgba(191, 219, 254, 0.8);">Years Exp.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TESTIMONIALS ═══ -->
  <section class="py-20 md:py-28" style="background: var(--color-slate);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="text-center mb-16 md:mb-20">
        <div class="section-label justify-center mb-3 reveal">Testimonials</div>
        <h2 class="reveal stagger-1">Your Neighbours Trust Us</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map((t, i) => (
          <div class={`reveal stagger-${i + 1} testimonial-card p-7`} style="border-left: 3px solid var(--color-blue);">
            <div class="flex gap-1 mb-4" style="color: var(--color-amber);">
              {[1,2,3,4,5].map(() => (
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <blockquote class="text-[0.9375rem] leading-[1.8] mb-6 italic" style="color: var(--color-text-primary);">
              &ldquo;{t.quote}&rdquo;
            </blockquote>
            <footer class="flex items-center gap-3 pt-5" style="border-top: 1px solid var(--color-border);">
              <div class="w-9 h-9 rounded-[3px] flex items-center justify-center text-[0.625rem] font-bold" style="background: var(--color-blue-subtle); color: var(--color-blue);">
                {t.name.split(' ').map(n => n[0]).join('')}
              </div>
              <div>
                <p class="text-[0.8125rem] font-semibold" style="color: var(--color-navy);">{t.name}</p>
                <p class="text-[0.6875rem]" style="color: var(--color-text-secondary);">{t.location}</p>
              </div>
            </footer>
          </div>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/contact#booking" class="btn-outline inline-flex items-center gap-2">
          Book Your Free Quote
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ SERVICE AREA ═══ -->
  <section class="py-20 md:py-28" style="background: var(--color-white);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="section-label mb-3 reveal">Service Area</div>
          <h2 class="reveal stagger-1 mb-4">A Local Plumber Near You</h2>
          <p class="text-[0.9375rem] leading-[1.7] mb-6 reveal stagger-2" style="color: var(--color-text-secondary);">
            Based in the CBD, your plumber is always close by — servicing all surrounding suburbs within a 15km radius.
          </p>
          <div class="flex flex-wrap gap-2 reveal stagger-3">
            {['Sydney CBD', 'Darlinghurst', 'Surry Hills', 'Pyrmont', 'Ultimo', 'Chippendale', 'Glebe', 'Newtown', 'Redfern', 'Paddington'].map(suburb => (
              <span class="text-[0.6875rem] font-semibold px-3 py-1.5 rounded-[2px]" style="background: var(--color-navy); color: #fff;">{suburb}</span>
            ))}
          </div>
        </div>
        <div class="reveal stagger-2">
          <div class="relative rounded-[3px] overflow-hidden border" style="border-color: var(--color-border); box-shadow: var(--shadow-elevated);">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3312.9!2d151.209!3d-33.867!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6b12ae3e3f05c8b1%3A0x5017d681632c7e0!2s78%20Pitt%20St%2C%20Sydney%20NSW%202000!5e0!3m2!1sen!2sau!4v1700000000000"
              width="100%" height="400" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Hartley & Co Plumbing location"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CTA ═══ -->
  <section class="relative py-20 md:py-28 overflow-hidden" style="background: var(--color-navy);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(0deg, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative max-w-[600px] mx-auto px-6 lg:px-10 text-center">
      <div class="section-label justify-center mb-3 reveal" style="color: var(--color-blue-light);">
        <span style="color: var(--color-blue-light);">Available 24/7</span>
      </div>
      <h2 class="mb-5 reveal stagger-1" style="color: #fff;">
        Ready to Fix Your<br class="hidden sm:block"> Plumbing Problem?
      </h2>
      <p class="text-[0.9375rem] leading-[1.75] mb-10 reveal stagger-2" style="color: rgba(148, 163, 184, 0.85);">
        Book online or call us — you'll get a free, no-obligation quote. No call-out fee, no hidden costs.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 reveal stagger-3">
        <a href="/contact#booking" class="btn-primary">
          Book a Plumber
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
