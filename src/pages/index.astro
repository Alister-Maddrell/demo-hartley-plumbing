---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: '24/7 Emergency Plumbing',
    description: 'Burst pipe flooding your kitchen at 2am? Your emergency plumber arrives in under 60 minutes across Sydney CBD, Surry Hills, and Darlinghurst — so the damage stops fast, not next morning.',
    image: 'https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=600&h=400&fit=crop',
    alt: 'Licensed Sydney emergency plumber with tools ready for burst pipe repair',
    tag: 'URGENT',
  },
  {
    title: 'Bathroom Renovations',
    description: 'Transform your outdated bathroom into a space you love. Full design-to-build renovations with licensed plumbing, waterproofing, and tiling — delivered on time, on budget, and backed by warranty.',
    image: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=600&h=400&fit=crop',
    alt: 'Modern bathroom renovation completed by Hartley & Co in inner Sydney',
    tag: 'POPULAR',
  },
  {
    title: 'Commercial Plumbing',
    description: 'Keep your Sydney CBD business running without plumbing headaches. Scheduled maintenance contracts, new fit-outs, and compliance work — so you stay open, compliant, and worry-free.',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=600&h=400&fit=crop',
    alt: 'Commercial plumbing maintenance for Sydney CBD office building',
    tag: 'B2B',
  },
];

const testimonials = [
  {
    quote: "Our hot water system died on a Sunday night. Hartley & Co had a plumber at our Darlinghurst apartment within 45 minutes and replaced the entire unit by Monday morning. Honestly lifesavers.",
    name: 'Sarah M.',
    location: 'Darlinghurst',
    rating: 5,
  },
  {
    quote: "We manage three office buildings near Martin Place and Hartley & Co handles all our plumbing maintenance. Three years running, not a single missed appointment. They just get the job done.",
    name: 'James T.',
    location: 'Martin Place',
    rating: 5,
  },
  {
    quote: "Hired them for a full bathroom reno in our Surry Hills terrace. They gutted and rebuilt the whole thing in under three weeks — new tiling, waterproofing, the lot. The result is stunning.",
    name: 'David & Lisa K.',
    location: 'Surry Hills',
    rating: 5,
  },
];

const stats = [
  { number: '2,400+', label: 'Jobs Completed', detail: 'across inner Sydney' },
  { number: '20+', label: 'Years in Sydney', detail: 'est. 2003' },
  { number: '60', label: 'Min Response', detail: 'avg. emergency arrival' },
  { number: '4.9', label: 'Google Rating', detail: '200+ verified reviews' },
];

const badges = [
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>',
    label: 'Licensed & Insured',
    detail: 'Your work is protected & covered',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
    label: '24/7 Callouts',
    detail: 'At your door in under 60 min',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>',
    label: '4.9\u2605 Rating',
    detail: '200+ verified reviews',
  },
  {
    icon: '<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/></svg>',
    label: 'Lifetime Guarantee',
    detail: 'If it breaks, we fix it free',
  },
];
---

<Layout
  title="Sydney CBD Plumber | 24/7 Emergency | Hartley & Co"
  description="Burst pipe or blocked drain in Sydney CBD? Hartley & Co plumbers arrive in under 60 minutes, 24/7. Licensed, insured, guaranteed. Get your free quote today."
>
  <!-- ========================================
       HERO — Full viewport, navy with grid
       ======================================== -->
  <section style="position: relative; background: var(--color-navy); overflow: hidden; min-height: 100dvh; display: flex; flex-direction: column; justify-content: center;">
    <!-- Background image — high visibility -->
    <div style="position: absolute; inset: 0; background-image: url('https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1920&h=1080&fit=crop&q=80'); background-size: cover; background-position: center;"></div>
    <!-- Minimal overlay for text legibility only -->
    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,26,46,0.45) 0%, rgba(12,26,46,0.55) 100%);"></div>

    <div style="position: relative; max-width: 800px; margin: 0 auto; padding: 7rem 1.5rem 4rem; text-align: center;">
      <!-- Availability badge -->
      <div class="reveal stagger-1" style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.08); color: #fff; font-family: var(--font-body); font-size: 0.875rem; font-weight: 600; padding: 0.5rem 1rem; border-radius: 8px; margin-bottom: 1.5rem; border: 1px solid rgba(255,255,255,0.1);">
        <span style="position: relative; display: flex; width: 8px; height: 8px;">
          <span style="position: absolute; display: inline-flex; width: 100%; height: 100%; border-radius: 50%; background: #34D399; opacity: 0.6; animation: pulse-dot 2s ease-in-out infinite;"></span>
          <span style="position: relative; display: inline-flex; width: 8px; height: 8px; border-radius: 50%; background: #34D399;"></span>
        </span>
        Available 24/7 for emergencies
      </div>

      <!-- Headline -->
      <h1 class="reveal stagger-2" style="color: #fff; font-family: var(--font-display); font-weight: 900; text-transform: uppercase; margin-bottom: 1.25rem; line-height: 1.05;">
        Burst Pipe? We're There<br />
        <span style="color: var(--color-blue-light);">in 60 Minutes</span>
      </h1>

      <!-- Accent bar -->
      <div class="reveal stagger-3" style="width: 4rem; height: 4px; background: var(--color-blue); margin: 0 auto 1.5rem; border-radius: 2px;"></div>

      <!-- Description -->
      <p class="reveal stagger-3" style="font-family: var(--font-body); font-size: 1.125rem; color: #CBD5E1; max-width: 600px; margin: 0 auto 2.5rem; line-height: 1.7;">
        Whether it's a 3am emergency or a blocked drain before guests arrive, your problem gets fixed fast — by licensed, insured plumbers who get it right the first time. Serving Sydney CBD, Surry Hills, Pyrmont, and all inner suburbs since 2003.
      </p>

      <!-- CTA buttons -->
      <div class="reveal stagger-4" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 3rem;">
        <a href="/booking" class="btn-primary" style="padding: 1rem 2rem; font-size: 1rem; border-radius: 8px;">
          Book a Plumber Now
          <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/services" class="btn-outline btn-outline-light" style="padding: 1rem 2rem; font-size: 1rem; border-radius: 8px;">
          See What We Fix
        </a>
      </div>

      <!-- Inline stats row -->
      <div class="reveal stagger-5" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; max-width: 600px; margin: 0 auto; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1);">
        {stats.map((stat) => (
          <div style="text-align: center;">
            <p class="stat-number" style="font-size: 1.5rem; color: #fff; margin-bottom: 0.125rem;">{stat.number}</p>
            <p style="font-family: var(--font-body); font-size: 0.6875rem; color: #94A3B8; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em;">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       TRUST BADGES — Horizontal bar
       ======================================== -->
  <section style="background: var(--color-slate); border-bottom: 1px solid var(--color-border);">
    <div style="max-width: 1100px; margin: 0 auto; padding: 1.5rem 1.5rem;">
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
        {badges.map((badge, i) => (
          <div class={`reveal stagger-${i + 1} trust-badge`} style="display: flex; align-items: flex-start; gap: 0.75rem;">
            <div style="width: 2.5rem; height: 2.5rem; background: var(--color-blue-pale); border: 1px solid #BFDBFE; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--color-blue); flex-shrink: 0;" set:html={badge.icon} />
            <div style="min-width: 0;">
              <p style="font-family: var(--font-display); font-weight: 700; color: var(--color-navy); font-size: 0.875rem; line-height: 1.3;">{badge.label}</p>
              <p style="font-family: var(--font-body); color: var(--color-text-muted); font-size: 0.75rem; margin-top: 0.125rem;">{badge.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       SERVICES — Cards with images
       ======================================== -->
  <section style="padding: 5rem 0; background: var(--color-white);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <!-- Section header -->
      <div class="reveal" style="text-align: center; margin-bottom: 3.5rem;">
        <p class="section-label" style="justify-content: center; margin-bottom: 0.75rem;">Services</p>
        <h2 style="color: var(--color-navy); margin-bottom: 0.75rem;">Problems Solved, Guaranteed</h2>
        <p style="font-family: var(--font-body); color: var(--color-text-secondary); font-size: 1.125rem; max-width: 32rem; margin: 0 auto; line-height: 1.65;">From emergency callouts to full renovations, every job is backed by a lifetime workmanship guarantee.</p>
      </div>

      <!-- Service cards -->
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        {services.map((service, i) => (
          <a href="/services" class={`reveal stagger-${i + 1} card card-blue`} style="display: block; text-decoration: none; overflow: hidden; border-radius: 8px;">
            <!-- Image -->
            <div style="height: 13rem; overflow: hidden; position: relative;">
              <img src={service.image} alt={service.alt} style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s;" loading="lazy" width="600" height="400" />
              <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.2), transparent);"></div>
              <!-- Tag -->
              <span style={`position: absolute; top: 0.75rem; left: 0.75rem; color: #fff; font-family: var(--font-display); font-size: 0.625rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.25rem 0.75rem; border-radius: 4px; background: ${service.tag === 'URGENT' ? 'var(--color-amber)' : 'var(--color-blue)'};`}>{service.tag}</span>
            </div>

            <!-- Content -->
            <div style="padding: 1.5rem;">
              <h3 style="font-family: var(--font-display); font-size: 1.125rem; font-weight: 700; color: var(--color-navy); margin-bottom: 0.5rem;">{service.title}</h3>
              <p style="font-family: var(--font-body); color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.7; margin-bottom: 1rem;">{service.description}</p>
              <span class="link-arrow" style="color: var(--color-blue); font-family: var(--font-body); font-weight: 700; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.375rem;">
                Learn More
                <svg style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       WHY CHOOSE US — Navy bg, split layout
       ======================================== -->
  <section style="position: relative; padding: 5rem 0; background: var(--color-navy); overflow: hidden;">
    <!-- Grid pattern -->
    <div style="position: absolute; inset: 0; opacity: 0.04; background-image: linear-gradient(0deg, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;">
        <!-- Left content -->
        <div class="reveal">
          <p class="section-label" style="color: var(--color-blue-light); margin-bottom: 0.75rem;">Why Hartley & Co</p>
          <h2 style="color: #fff; margin-bottom: 1.25rem;">Why Sydney Trusts Hartley & Co</h2>
          <p style="font-family: var(--font-body); color: #CBD5E1; font-size: 1.0625rem; line-height: 1.7; margin-bottom: 2rem;">
            You deserve a plumber who shows up on time, charges what they quoted, and fixes it right the first time. Third-generation tradespeople, no shortcuts, no surprises.
          </p>

          <!-- Feature items with check icons -->
          <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            <div style="display: flex; align-items: flex-start; gap: 1rem;">
              <div style="width: 2.5rem; height: 2.5rem; background: rgba(37,99,235,0.15); border: 1px solid rgba(59,130,246,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 0.125rem;">
                <svg style="width: 1.25rem; height: 1.25rem; color: var(--color-blue-light);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              </div>
              <div>
                <p style="font-family: var(--font-display); color: #fff; font-weight: 700; font-size: 0.875rem; margin-bottom: 0.25rem;">At Your Door in 60 Minutes</p>
                <p style="font-family: var(--font-body); color: #94A3B8; font-size: 0.875rem; line-height: 1.6;">No waiting, no uncertainty. Your nearest plumber is dispatched the moment you call — day or night.</p>
              </div>
            </div>

            <div style="display: flex; align-items: flex-start; gap: 1rem;">
              <div style="width: 2.5rem; height: 2.5rem; background: rgba(37,99,235,0.15); border: 1px solid rgba(59,130,246,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 0.125rem;">
                <svg style="width: 1.25rem; height: 1.25rem; color: var(--color-blue-light);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              </div>
              <div>
                <p style="font-family: var(--font-display); color: #fff; font-weight: 700; font-size: 0.875rem; margin-bottom: 0.25rem;">Know the Price Before Work Starts</p>
                <p style="font-family: var(--font-body); color: #94A3B8; font-size: 0.875rem; line-height: 1.6;">You get a written quote upfront — so there are no surprises on your invoice. No hidden fees, ever.</p>
              </div>
            </div>

            <div style="display: flex; align-items: flex-start; gap: 1rem;">
              <div style="width: 2.5rem; height: 2.5rem; background: rgba(37,99,235,0.15); border: 1px solid rgba(59,130,246,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 0.125rem;">
                <svg style="width: 1.25rem; height: 1.25rem; color: var(--color-blue-light);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
              </div>
              <div>
                <p style="font-family: var(--font-display); color: #fff; font-weight: 700; font-size: 0.875rem; margin-bottom: 0.25rem;">Guaranteed — or You Don't Pay</p>
                <p style="font-family: var(--font-body); color: #94A3B8; font-size: 0.875rem; line-height: 1.6;">If anything we fixed breaks down, you're covered. We come back and repair it free of charge.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right image -->
        <div class="reveal-fade" style="position: relative;">
          <div style="position: relative; border-radius: 8px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.2), 0 4px 12px rgba(0,0,0,0.1);">
            <img
              src="https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=700&h=900&fit=crop"
              alt="Professional plumber with tools ready for work"
              style="width: 100%; object-fit: cover; aspect-ratio: 3/4; display: block;"
              width="700"
              height="900"
              loading="lazy"
            />
            <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(12,26,46,0.4), transparent);"></div>
          </div>

          <!-- 20+ Years badge -->
          <div style="position: absolute; left: -1rem; bottom: -1rem; background: var(--color-blue); color: #fff; border-radius: 8px; padding: 1.25rem; box-shadow: 0 8px 24px rgba(37,99,235,0.3);">
            <p style="font-family: var(--font-display); font-size: 1.875rem; font-weight: 900; line-height: 1;">20+</p>
            <p style="font-family: var(--font-body); color: #BFDBFE; font-size: 0.6875rem; font-weight: 600; margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.08em;">Years Exp.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       TESTIMONIALS — 3 cards
       ======================================== -->
  <section style="padding: 5rem 0; background: var(--color-slate);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <div class="reveal" style="text-align: center; margin-bottom: 3.5rem;">
        <p class="section-label" style="justify-content: center; margin-bottom: 0.75rem;">Testimonials</p>
        <h2 style="color: var(--color-navy); margin-bottom: 0.75rem;">Your Neighbours Trust Us</h2>
        <p style="font-family: var(--font-body); color: var(--color-text-secondary); font-size: 1.125rem; max-width: 28rem; margin: 0 auto;">Hear from real homeowners and businesses across Sydney's CBD and inner suburbs.</p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
        {testimonials.map((t, i) => (
          <div class={`reveal stagger-${i + 1} testimonial-card`} style="padding: 1.5rem;">
            <!-- Stars -->
            <div style="display: flex; gap: 0.25rem; color: var(--color-amber); margin-bottom: 1rem;">
              {Array(t.rating).fill(null).map(() => (
                <svg style="width: 1rem; height: 1rem;" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <blockquote style="font-family: var(--font-body); color: var(--color-text-secondary); font-size: 0.875rem; line-height: 1.75; margin-bottom: 1.5rem;">"{t.quote}"</blockquote>
            <div style="display: flex; align-items: center; gap: 0.75rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border-light);">
              <!-- Avatar initials -->
              <div style="width: 2.5rem; height: 2.5rem; background: var(--color-navy); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                <span style="color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 0.75rem;">{t.name.split(' ').map(n => n[0]).join('')}</span>
              </div>
              <div>
                <p style="font-family: var(--font-display); color: var(--color-navy); font-weight: 700; font-size: 0.875rem;">{t.name}</p>
                <p style="font-family: var(--font-body); color: var(--color-text-muted); font-size: 0.75rem; margin-top: 0.125rem;">{t.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================
       SERVICE AREA — Split layout with map
       ======================================== -->
  <section style="padding: 5rem 0; background: var(--color-white);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div class="reveal">
          <p class="section-label" style="margin-bottom: 0.75rem;">Service Area</p>
          <h2 style="color: var(--color-navy); margin-bottom: 0.75rem;">A Local Plumber Near You</h2>
          <p style="font-family: var(--font-body); color: var(--color-text-secondary); font-size: 1.0625rem; line-height: 1.7; margin-bottom: 1.5rem;">
            Based in the CBD, your plumber is always close by — servicing all surrounding suburbs within a 15km radius. For larger commercial jobs, the greater Sydney metro area is covered too.
          </p>
          <!-- Suburb tags -->
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {['Sydney CBD', 'Darlinghurst', 'Surry Hills', 'Pyrmont', 'Ultimo', 'Chippendale', 'Glebe', 'Newtown', 'Redfern', 'Paddington'].map(suburb => (
              <span style="background: var(--color-navy); color: #fff; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; padding: 0.375rem 0.75rem; border-radius: 8px;">{suburb}</span>
            ))}
          </div>
        </div>
