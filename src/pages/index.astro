---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const services = [
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>',
    title: 'Emergency Repairs',
    description: 'Burst pipes, blocked drains, gas leaks — we respond within 60 minutes across the CBD.',
    image: 'https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=600&h=400&fit=crop',
    alt: 'Plumbing tools including pipe wrench laid out for emergency repair work',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>',
    title: 'Bathroom Renovations',
    description: 'Complete bathroom renovations from design to completion, on time and on budget.',
    image: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=600&h=400&fit=crop',
    alt: 'Modern renovated bathroom with clean white fixtures and elegant tiling',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>',
    title: 'Commercial Plumbing',
    description: 'Ongoing maintenance contracts and fit-outs for offices, restaurants, and retail.',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=600&h=400&fit=crop',
    alt: 'Modern commercial office building with glass facade reflecting the sky',
  },
];

const testimonials = [
  {
    quote: "Hartley & Co fixed our burst pipe at 11pm on a Sunday. Professional, fast, and reasonably priced. Can't recommend them enough.",
    name: 'Sarah M.',
    location: 'Darlinghurst',
  },
  {
    quote: "We've used them for our office building maintenance for 3 years now. Always reliable, always on time.",
    name: 'James T.',
    location: 'Building Manager, Martin Place',
  },
  {
    quote: 'The bathroom renovation exceeded our expectations. They kept us informed every step of the way.',
    name: 'David & Lisa K.',
    location: 'Surry Hills',
  },
];

const badges = [
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>',
    label: 'Licensed & Insured',
    detail: 'NSW Licensed',
  },
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>',
    label: '24/7 Emergency',
    detail: '60 Min Response',
  },
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>',
    label: '20+ Years Experience',
    detail: 'Est. 2003',
  },
  {
    icon: '<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>',
    label: 'Google 4.9★ Rating',
    detail: '200+ Reviews',
  },
];
---

<Layout
  title="Hartley & Co Plumbing — Sydney CBD's Trusted Plumbing Experts"
  description="Licensed, insured plumbers in Sydney CBD. 24/7 emergency repairs, bathroom renovations, and commercial plumbing. Call 0412 555 178 for a free quote."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Multi-layer gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark via-primary to-primary"></div>
    <!-- Ambient glow -->
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary-light/15 rounded-full blur-[120px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-primary-lighter/10 rounded-full blur-[100px] translate-y-1/3 -translate-x-1/4 pointer-events-none"></div>
    <!-- Subtle dot pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>

    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-24 md:py-32 lg:py-40">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="text-center lg:text-left">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-blue-100 text-sm font-medium px-4 py-2 rounded-full mb-8 border border-white/10">
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
            Available 24/7 for emergencies
          </div>

          <h1 class="text-[40px] sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-white leading-[1.08] tracking-[-0.02em] mb-6">
            Sydney CBD's Trusted Plumbing Experts
          </h1>
          <p class="text-lg md:text-xl text-blue-100/80 max-w-2xl mb-12 leading-relaxed">
            Licensed, insured, and available 24/7 for emergency repairs across the Sydney CBD and surrounding suburbs.
          </p>
          <div class="flex flex-col sm:flex-row items-center lg:items-start justify-center lg:justify-start gap-4">
            <a
              href="/contact"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-accent hover:bg-accent-hover text-white font-semibold px-8 py-4 rounded-full text-lg shadow-[0_4px_16px_rgba(249,115,22,0.4)] hover:shadow-[0_6px_24px_rgba(249,115,22,0.5)] hover:-translate-y-0.5 transition-all"
            >
              Get a Free Quote
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a
              href="/services"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/15 text-white font-semibold px-8 py-4 rounded-full text-lg transition-all"
            >
              Our Services
            </a>
          </div>
        </div>
        <div class="hidden lg:block">
          <div class="relative">
            <img
              src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=800&h=1000&fit=crop"
              alt="Modern clean bathroom showcasing professional plumbing installation with white fixtures"
              class="w-full rounded-2xl shadow-2xl object-cover aspect-[4/5]"
              width="800"
              height="1000"
              loading="eager"
            />
            <div class="absolute inset-0 rounded-2xl ring-1 ring-white/10"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="relative -mt-8 z-10 pb-12">
    <div class="max-w-6xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
        {badges.map((badge, i) => (
          <div class={`reveal stagger-${i + 1} bg-white rounded-2xl shadow-[var(--shadow-medium)] p-6 md:p-7 flex items-start gap-4 hover:shadow-[var(--shadow-elevated)] hover:-translate-y-1.5 transition-all duration-300`}>
            <div class="w-12 h-12 bg-primary-50 rounded-xl flex items-center justify-center text-primary shrink-0" set:html={badge.icon} />
            <div class="min-w-0">
              <p class="font-bold text-text-primary text-sm leading-tight">{badge.label}</p>
              <p class="text-text-muted text-xs mt-1">{badge.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Preview -->
  <section class="py-24 md:py-36">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="text-center mb-16 md:mb-20 reveal">
        <p class="text-primary-500 text-xs font-semibold tracking-[0.15em] uppercase mb-4">What We Do</p>
        <h2 class="mb-5">Professional Plumbing Services</h2>
        <p class="text-text-secondary text-lg max-w-xl mx-auto leading-relaxed">Trusted solutions for homes and businesses across Sydney's CBD and inner suburbs.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        {services.map((service, i) => (
          <a href="/services" class={`reveal stagger-${i + 1} group bg-white rounded-2xl shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-elevated)] transition-all duration-350 hover:-translate-y-2 block overflow-hidden`}>
            <div class="h-52 overflow-hidden">
              <img src={service.image} alt={service.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="600" height="400" />
            </div>
            <div class="p-8 md:p-10">
              <div class="w-14 h-14 bg-primary-50 group-hover:bg-primary-100 rounded-2xl flex items-center justify-center text-primary mb-6 transition-colors duration-300" set:html={service.icon} />
              <h3 class="text-xl font-bold text-text-primary mb-3">{service.title}</h3>
              <p class="text-text-secondary text-[15px] leading-relaxed mb-6">{service.description}</p>
              <span class="text-primary-500 font-semibold text-sm inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all duration-300">
                Learn More
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="bg-bg-light py-24 md:py-36">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="text-center mb-16 md:mb-20 reveal">
        <p class="text-primary-500 text-xs font-semibold tracking-[0.15em] uppercase mb-4">Testimonials</p>
        <h2>What Our Clients Say</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        {testimonials.map((t, i) => (
          <div class={`reveal stagger-${i + 1} bg-white rounded-2xl shadow-[var(--shadow-soft)] hover:shadow-[var(--shadow-medium)] p-8 md:p-10 relative transition-all duration-300 hover:-translate-y-1`}>
            <svg class="absolute top-7 right-8 w-12 h-12 text-primary-700/[0.04]" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z"/></svg>

            <div class="flex gap-1 text-amber-400 mb-6">
              {Array(5).fill(null).map(() => (
                <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <blockquote class="text-text-secondary text-[15px] leading-[1.75] mb-8">"{t.quote}"</blockquote>
            <div class="flex items-center gap-3 pt-6 border-t border-border">
              <div class="w-10 h-10 bg-primary-50 rounded-full flex items-center justify-center">
                <span class="text-primary font-bold text-sm">{t.name.charAt(0)}</span>
              </div>
              <div>
                <p class="text-text-primary font-semibold text-sm">{t.name}</p>
                <p class="text-text-muted text-xs mt-0.5">{t.location}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner />
</Layout>
