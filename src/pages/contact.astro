---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us — Hartley & Co Plumbing"
  description="Get a free plumbing quote from Hartley & Co. Call 0412 555 178 or fill out our contact form. We respond within 2 hours during business hours."
>
  <!-- Page Header -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark via-primary to-primary"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary-light/15 rounded-full blur-[120px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 32px 32px;"></div>
    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-20 md:py-28 text-center">
      <p class="text-primary-lighter/80 text-sm font-semibold tracking-wide uppercase mb-4">Contact Us</p>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-[-0.02em] leading-[1.08] mb-5">Get In Touch</h1>
      <p class="text-lg md:text-xl text-blue-100/70 max-w-2xl mx-auto leading-relaxed">
        Request a free quote or ask us anything. We'll get back to you within 2 hours during business hours.
      </p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-10 lg:gap-16">
        <!-- Contact Form (3 cols) -->
        <div class="lg:col-span-3">
          <div class="bg-white rounded-2xl shadow-[var(--shadow-medium)] p-8 md:p-10">
            <h2 class="text-2xl font-bold text-text-primary tracking-tight mb-2">Send Us a Message</h2>
            <p class="text-text-secondary text-[15px] mb-8">Fill out the form below and we'll get back to you promptly.</p>

            <form id="contact-form" action="https://formspree.io/f/placeholder" method="POST" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-sm font-medium text-text-primary mb-2">Full Name</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full px-4 py-3.5 bg-bg-light border border-border rounded-xl focus:ring-2 focus:ring-primary-light/20 focus:border-primary-light outline-none transition-all text-[15px] placeholder:text-text-muted"
                    placeholder="John Smith"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-text-primary mb-2">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full px-4 py-3.5 bg-bg-light border border-border rounded-xl focus:ring-2 focus:ring-primary-light/20 focus:border-primary-light outline-none transition-all text-[15px] placeholder:text-text-muted"
                    placeholder="john@example.com"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="phone" class="block text-sm font-medium text-text-primary mb-2">Phone</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    class="w-full px-4 py-3.5 bg-bg-light border border-border rounded-xl focus:ring-2 focus:ring-primary-light/20 focus:border-primary-light outline-none transition-all text-[15px] placeholder:text-text-muted"
                    placeholder="0412 345 678"
                  />
                </div>
                <div>
                  <label for="service" class="block text-sm font-medium text-text-primary mb-2">Service Needed</label>
                  <select
                    id="service"
                    name="service"
                    class="w-full px-4 py-3.5 bg-bg-light border border-border rounded-xl focus:ring-2 focus:ring-primary-light/20 focus:border-primary-light outline-none transition-all text-[15px] text-text-secondary"
                  >
                    <option value="">Select a service...</option>
                    <option value="Emergency Repair">Emergency Repair</option>
                    <option value="Bathroom Renovation">Bathroom Renovation</option>
                    <option value="Commercial Plumbing">Commercial Plumbing</option>
                    <option value="Hot Water System">Hot Water System</option>
                    <option value="Drain Cleaning">Drain Cleaning</option>
                    <option value="Gas Fitting">Gas Fitting</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>
              <div>
                <label for="message" class="block text-sm font-medium text-text-primary mb-2">Message</label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3.5 bg-bg-light border border-border rounded-xl focus:ring-2 focus:ring-primary-light/20 focus:border-primary-light outline-none transition-all text-[15px] placeholder:text-text-muted resize-vertical"
                  placeholder="Tell us about your plumbing issue or project..."
                ></textarea>
              </div>
              <button
                type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 bg-accent hover:bg-accent-hover text-white font-semibold px-10 py-4 rounded-full text-lg shadow-[0_4px_16px_rgba(249,115,22,0.3)] hover:shadow-[0_6px_24px_rgba(249,115,22,0.4)] hover:-translate-y-0.5 transition-all"
              >
                Send Message
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg>
              </button>
            </form>

            <!-- Success message -->
            <div id="form-success" class="hidden py-12 text-center">
              <div class="w-16 h-16 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-5">
                <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <h3 class="text-xl font-bold text-text-primary mb-2">Message Sent!</h3>
              <p class="text-text-secondary text-[15px] max-w-sm mx-auto">Thanks for reaching out. We'll get back to you within 2 hours during business hours.</p>
            </div>
          </div>
        </div>

        <!-- Contact Details (2 cols) -->
        <div class="lg:col-span-2 space-y-6">
          <!-- Quick contact card -->
          <div class="bg-primary rounded-2xl p-8 text-white relative overflow-hidden">
            <div class="absolute top-0 right-0 w-40 h-40 bg-white/5 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
            <h3 class="text-lg font-bold mb-1 relative">Need help right away?</h3>
            <p class="text-blue-200/70 text-sm mb-5 relative">Our team is available 24/7 for emergencies.</p>
            <a
              href="tel:0412555178"
              class="relative inline-flex items-center gap-2.5 bg-white text-primary font-semibold px-6 py-3 rounded-full text-sm hover:shadow-lg hover:-translate-y-0.5 transition-all"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              Call 0412 555 178
            </a>
          </div>

          <!-- Business details card -->
          <div class="bg-white rounded-2xl shadow-[var(--shadow-medium)] p-8">
            <h3 class="text-lg font-bold text-text-primary tracking-tight mb-6">Business Details</h3>
            <ul class="space-y-5">
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/5 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </div>
                <div>
                  <p class="font-semibold text-text-primary text-sm">Address</p>
                  <p class="text-text-secondary text-sm mt-0.5">78 Pitt Street, Sydney NSW 2000</p>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/5 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <div>
                  <p class="font-semibold text-text-primary text-sm">Phone</p>
                  <a href="tel:0412555178" class="text-primary-light hover:text-primary text-sm mt-0.5 inline-block transition-colors">0412 555 178</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/5 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div>
                  <p class="font-semibold text-text-primary text-sm">Email</p>
                  <a href="mailto:info@hartleyplumbing.com.au" class="text-primary-light hover:text-primary text-sm mt-0.5 inline-block transition-colors">info@hartleyplumbing.com.au</a>
                </div>
              </li>
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 bg-primary/5 rounded-xl flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
                <div>
                  <p class="font-semibold text-text-primary text-sm">ABN</p>
                  <p class="text-text-secondary text-sm mt-0.5">12 345 678 901</p>
                </div>
              </li>
            </ul>

            <!-- Hours -->
            <div class="mt-8 pt-6 border-t border-border">
              <h4 class="font-semibold text-text-primary text-sm mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Business Hours
              </h4>
              <ul class="space-y-2.5 text-sm">
                <li class="flex justify-between">
                  <span class="text-text-secondary">Mon – Fri</span>
                  <span class="font-medium text-text-primary">7am – 6pm</span>
                </li>
                <li class="flex justify-between">
                  <span class="text-text-secondary">Saturday</span>
                  <span class="font-medium text-text-primary">8am – 2pm</span>
                </li>
                <li class="flex justify-between">
                  <span class="text-text-secondary">Sunday</span>
                  <span class="font-medium text-accent">Emergency Only</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Map -->
          <div class="rounded-2xl overflow-hidden shadow-[var(--shadow-medium)]">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3312.9!2d151.209!3d-33.867!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6b12ae3e3f05c8b1%3A0x5017d681632c7e0!2s78%20Pitt%20St%2C%20Sydney%20NSW%202000!5e0!3m2!1sen!2sau!4v1700000000000"
              width="100%"
              height="280"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Hartley & Co Plumbing location"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (response.ok) {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      }
    } catch {
      // If formspree isn't configured, still show success for demo
      form.classList.add('hidden');
      success?.classList.remove('hidden');
    }
  });
</script>
