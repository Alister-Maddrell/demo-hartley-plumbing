---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout
  title="Book a Plumber in Sydney CBD | Hartley & Co"
  description="Book your plumber online or call 0412 555 178. Free quote, no obligation, no call-out fee. Available 24/7 for emergencies across Sydney CBD."
>
  <Navbar />

  <!-- Page Header -->
  <section class="relative pt-32 pb-14 md:pt-40 md:pb-20" style="background: var(--color-navy);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(0deg, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 lg:px-10 text-center">
      <div class="section-label justify-center mb-3 reveal" style="color: var(--color-blue-light);"><span style="color: var(--color-blue-light);">Book a Plumber</span></div>
      <h1 class="reveal stagger-1" style="color: #fff;">Book Your Plumber Online</h1>
      <p class="text-[1.0625rem] leading-[1.75] max-w-2xl mx-auto mt-5 reveal stagger-2" style="color: rgba(203, 213, 225, 0.85);">
        Pick a time that suits you. A licensed plumber will confirm within 2 hours — no obligation, no call-out fee.
      </p>
      <div class="mt-5 reveal stagger-3">
        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-[3px] text-[0.6875rem] font-semibold" style="background: rgba(37, 99, 235, 0.15); color: var(--color-blue-light); border: 1px solid rgba(59, 130, 246, 0.2);">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Free consultation &middot; 30 minutes
        </span>
      </div>
    </div>
  </section>

  <!-- Cal.com Booking -->
  <section id="booking" class="py-16 md:py-24" style="background: var(--color-slate);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="text-center mb-10 reveal">
        <div class="section-label justify-center mb-3">Schedule Your Job</div>
        <h2 class="reveal stagger-1">Pick a Time That Works</h2>
        <p class="mt-4 text-[0.9375rem] leading-[1.7] max-w-lg mx-auto reveal stagger-2" style="color: var(--color-text-secondary);">
          Choose your preferred time below. A licensed plumber will confirm within 2 hours.
        </p>
      </div>

      <div class="max-w-3xl mx-auto reveal stagger-2">
        <div class="card card-blue overflow-hidden">
          <div id="cal-embed" style="min-height: 400px;"></div>
        </div>
        <p class="text-center mt-4 text-[0.6875rem]" style="color: var(--color-text-muted);">
          Powered by Cal.com
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Form + Details -->
  <section class="py-16 md:py-24" style="background: var(--color-white);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-12">
        <!-- Form -->
        <div class="lg:col-span-3">
          <div class="section-label mb-3 reveal">Or Send Us a Message</div>
          <div class="card card-blue overflow-hidden p-7 md:p-9 reveal stagger-1">
            <form id="contact-form" action="https://formspree.io/f/placeholder" method="POST" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="name" class="block text-[0.8125rem] font-semibold mb-1.5" style="color: var(--color-navy);">Full Name</label>
                  <input type="text" id="name" name="name" required class="w-full px-4 py-3 border rounded-[3px] text-[0.875rem]" style="border-color: var(--color-border); background: var(--color-slate);" placeholder="John Smith" />
                </div>
                <div>
                  <label for="email" class="block text-[0.8125rem] font-semibold mb-1.5" style="color: var(--color-navy);">Email</label>
                  <input type="email" id="email" name="email" required class="w-full px-4 py-3 border rounded-[3px] text-[0.875rem]" style="border-color: var(--color-border); background: var(--color-slate);" placeholder="john@example.com" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="phone" class="block text-[0.8125rem] font-semibold mb-1.5" style="color: var(--color-navy);">Phone</label>
                  <input type="tel" id="phone" name="phone" class="w-full px-4 py-3 border rounded-[3px] text-[0.875rem]" style="border-color: var(--color-border); background: var(--color-slate);" placeholder="0412 345 678" />
                </div>
                <div>
                  <label for="service" class="block text-[0.8125rem] font-semibold mb-1.5" style="color: var(--color-navy);">Service Needed</label>
                  <select id="service" name="service" class="w-full px-4 py-3 border rounded-[3px] text-[0.875rem]" style="border-color: var(--color-border); background: var(--color-slate); color: var(--color-text-secondary);">
                    <option value="">Select a service...</option>
                    <option value="Emergency Repair">Emergency Repair</option>
                    <option value="Bathroom Renovation">Bathroom Renovation</option>
                    <option value="Commercial Plumbing">Commercial Plumbing</option>
                    <option value="Hot Water System">Hot Water System</option>
                    <option value="Drain Cleaning">Drain Cleaning</option>
                    <option value="Gas Fitting">Gas Fitting</option>
                    <option value="Other">Other</option>
                  </select>
                </div>
              </div>
              <div>
                <label for="message" class="block text-[0.8125rem] font-semibold mb-1.5" style="color: var(--color-navy);">Message</label>
                <textarea id="message" name="message" rows="4" required class="w-full px-4 py-3 border rounded-[3px] text-[0.875rem] resize-vertical" style="border-color: var(--color-border); background: var(--color-slate);" placeholder="Tell us about your plumbing issue..."></textarea>
              </div>
              <button type="submit" class="btn-primary">
                Send Message
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"/></svg>
              </button>
            </form>

            <div id="form-success" class="hidden py-12 text-center">
              <div class="w-14 h-14 rounded-[3px] flex items-center justify-center mx-auto mb-4" style="background: var(--color-blue-subtle); color: var(--color-blue); border: 1px solid var(--color-blue-pale);">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <h3 class="text-lg font-bold mb-2" style="color: var(--color-navy); font-family: var(--font-display); text-transform: uppercase;">Message Sent!</h3>
              <p class="text-[0.875rem]" style="color: var(--color-text-secondary);">We'll get back to you within 2 hours during business hours.</p>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="lg:col-span-2 space-y-5">
          <!-- Emergency -->
          <div class="rounded-[3px] p-7 relative overflow-hidden reveal" style="background: var(--color-navy);">
            <div class="relative">
              <div class="flex items-center gap-2 mb-3">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-60" style="background: var(--color-amber);"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2" style="background: var(--color-amber);"></span>
                </span>
                <span class="text-[0.625rem] font-bold tracking-[0.14em] uppercase" style="color: var(--color-amber);">24/7 Emergency</span>
              </div>
              <h3 class="text-[1rem] font-bold mb-2" style="color: #fff; font-family: var(--font-display); text-transform: uppercase;">Plumbing emergency?</h3>
              <p class="text-[0.8125rem] mb-5 leading-relaxed" style="color: rgba(148, 163, 184, 0.8);">Skip the form — your plumber can be there in under 60 minutes.</p>
              <a href="tel:0412555178" class="btn-primary !text-[0.8125rem] !py-2.5 !px-5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                Call 0412 555 178
              </a>
            </div>
          </div>

          <!-- Details -->
          <div class="card card-blue p-7 reveal stagger-1">
            <h3 class="text-[0.875rem] font-bold mb-5" style="color: var(--color-navy); font-family: var(--font-display); text-transform: uppercase;">Business Details</h3>
            <ul class="space-y-4 text-[0.8125rem]">
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 shrink-0 mt-0.5" style="color: var(--color-blue);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <span style="color: var(--color-text-secondary);">78 Pitt Street, Sydney NSW 2000</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 shrink-0 mt-0.5" style="color: var(--color-blue);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                <a href="tel:0412555178" class="font-semibold hover:underline underline-offset-4" style="color: var(--color-blue);">0412 555 178</a>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-4 h-4 shrink-0 mt-0.5" style="color: var(--color-blue);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                <a href="mailto:info@hartleyplumbing.com.au" class="font-semibold hover:underline underline-offset-4 break-all" style="color: var(--color-blue);">info@hartleyplumbing.com.au</a>
              </li>
            </ul>

            <div class="mt-6 pt-5" style="border-top: 1px solid var(--color-border);">
              <h4 class="text-[0.75rem] font-bold mb-3 uppercase tracking-[0.1em]" style="color: var(--color-navy); font-family: var(--font-display);">Hours</h4>
              <ul class="space-y-2 text-[0.8125rem]">
                <li class="flex justify-between"><span style="color: var(--color-text-secondary);">Mon – Fri</span><span class="font-semibold" style="color: var(--color-navy);">7am – 6pm</span></li>
                <li class="flex justify-between"><span style="color: var(--color-text-secondary);">Saturday</span><span class="font-semibold" style="color: var(--color-navy);">8am – 2pm</span></li>
                <li class="flex justify-between"><span style="color: var(--color-text-secondary);">Sunday</span><span class="font-semibold" style="color: var(--color-amber);">Emergency Only</span></li>
              </ul>
            </div>
          </div>

          <!-- Map -->
          <div class="rounded-[3px] overflow-hidden border reveal stagger-2" style="border-color: var(--color-border); box-shadow: var(--shadow-card);">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3312.9!2d151.209!3d-33.867!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6b12ae3e3f05c8b1%3A0x5017d681632c7e0!2s78%20Pitt%20St%2C%20Sydney%20NSW%202000!5e0!3m2!1sen!2sau!4v1700000000000"
              width="100%" height="240" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Hartley & Co Plumbing location"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    // Cal.com embed
    (function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          typeof namespace === "string" ? (cal.ns[namespace] = api) && p(api, ar) : p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", { origin: "https://cal.com" });
    Cal("inline", {
      calLink: "alister-maddrell-rmtqo9/consultation",
      elementOrSelector: "#cal-embed",
      config: { theme: "light", styles: { branding: { brandColor: "#2563EB" } } }
    });
    Cal("ui", { hideEventTypeDetails: false });

    // Contact form
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const success = document.getElementById('form-success');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          form.classList.add('hidden');
          success?.classList.remove('hidden');
        }
      } catch {
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      }
    });
  </script>
</Layout>
