---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const services = [
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>',
    title: 'Emergency Repairs',
    description: 'Burst pipes, blocked drains, gas leaks, or flooding — your emergency plumber arrives within 60 minutes, 24/7, so the damage stops before it gets worse.',
    borderClass: 'card-amber',
    image: 'https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=600&h=400&fit=crop',
    alt: 'Plumbing tools ready for emergency repair',
  },
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>',
    title: 'Bathroom Renovations',
    description: 'Get the bathroom you have always wanted. One team handles plumbing, tiling, waterproofing, and fixtures from concept to completion — one point of contact, not five.',
    borderClass: 'card-blue',
    image: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=600&h=400&fit=crop',
    alt: 'Modern renovated bathroom with clean white fixtures',
  },
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>',
    title: 'Commercial Plumbing',
    description: 'Avoid costly shutdowns and compliance headaches. Scheduled maintenance, new fit-outs, and compliance work keep your business running smoothly.',
    borderClass: 'card-blue',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=600&h=400&fit=crop',
    alt: 'Modern commercial office building',
  },
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1.001A3.75 3.75 0 0012 18z"/></svg>',
    title: 'Hot Water Systems',
    description: 'No hot water is miserable — get yours back fast. Same-day supply, installation, and repair across all brands: gas, electric, solar, and heat pump.',
    borderClass: 'card-amber',
    image: 'https://images.unsplash.com/photo-1585128792020-803d29415281?w=600&h=400&fit=crop',
    alt: 'Modern hot water system unit',
  },
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
    title: 'Drain Cleaning',
    description: 'Stop recurring blockages for good. CCTV drain inspections pinpoint the exact problem, then high-pressure jet blasting clears it permanently.',
    borderClass: 'card-blue',
    image: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&h=400&fit=crop',
    alt: 'Professional drain cleaning equipment',
  },
  {
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/></svg>',
    title: 'Gas Fitting',
    description: 'Protect your family with licensed gas work. Cooktop installations, gas line repairs, leak detection, and compliance certificates — all done safely and to code.',
    borderClass: 'card-amber',
    image: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=400&fit=crop',
    alt: 'Gas cooktop with blue flames',
  },
];

const steps = [
  { number: '01', title: 'Book Online or Call', description: 'Pick a time that works for you, or call for urgent jobs. You hear back within minutes.' },
  { number: '02', title: 'Get Your Free Quote', description: 'A transparent, written quote before any work starts. No obligation, no pressure.' },
  { number: '03', title: 'Problem Fixed Right', description: 'Licensed plumber completes the work on time, on the quoted price.' },
  { number: '04', title: "You're Covered", description: 'Every job backed by a lifetime workmanship guarantee. If it breaks, we fix it free.' },
];

const faqs = [
  { question: 'Do you charge a call-out fee?', answer: 'No. You get a free assessment and written quote for all standard jobs. Emergency after-hours calls may incur a service fee, but you will always know the cost before a plumber is dispatched.' },
  { question: 'Are you available on weekends?', answer: 'Yes. We work Saturdays 8am-2pm for scheduled jobs, and our emergency line is available 24/7 including Sundays and public holidays.' },
  { question: 'Do you provide written quotes?', answer: 'Always. Every job receives a detailed written quote before any work begins. No surprises, no hidden costs.' },
  { question: 'Are your plumbers licensed?', answer: "Yes — every plumber holds a current NSW plumbing licence and is fully insured. Licence numbers are available on request." },
  { question: 'What suburbs do you cover?', answer: "If you are in inner Sydney — within 15km of the CBD — you are in the service area. For larger commercial jobs, the greater Sydney metro area is also covered." },
];
---

<Layout
  title="Plumbing Services Sydney CBD | Hartley & Co Plumbing"
  description="Emergency repairs, bathroom renos, hot water systems and more in Sydney CBD. Licensed plumbers, upfront pricing, lifetime guarantee. Book your plumber now."
>
  <Navbar />

  <!-- Page Header -->
  <section class="relative pt-32 pb-14 md:pt-40 md:pb-20" style="background: var(--color-navy);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(0deg, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 lg:px-10 text-center">
      <div class="section-label justify-center mb-3 reveal" style="color: var(--color-blue-light);"><span style="color: var(--color-blue-light);">Our Services</span></div>
      <h1 class="reveal stagger-1" style="color: #fff;">Every Plumbing Problem Solved</h1>
      <p class="text-[1.0625rem] leading-[1.75] max-w-2xl mx-auto mt-5 reveal stagger-2" style="color: rgba(203, 213, 225, 0.85);">
        From midnight emergencies to dream bathroom renovations — handled by licensed Sydney tradespeople.
      </p>
    </div>
  </section>

  <!-- Service Cards -->
  <section class="py-20 md:py-28" style="background: var(--color-slate);">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service, i) => (
          <a href="/contact#booking" class={`reveal stagger-${(i % 3) + 1} card ${service.borderClass} group overflow-hidden block`}>
            <div class="h-48 overflow-hidden relative">
              <img src={service.image} alt={service.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
              <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.15), transparent);"></div>
            </div>
            <div class="p-6">
              <div class="w-11 h-11 rounded-[3px] flex items-center justify-center mb-4" style="background: var(--color-blue-subtle); color: var(--color-blue); border: 1px solid var(--color-blue-pale);" set:html={service.icon} />
              <h3 class="text-[1.05rem] font-bold mb-2" style="color: var(--color-navy);">{service.title}</h3>
              <p class="text-[0.8125rem] leading-relaxed mb-4" style="color: var(--color-text-secondary);">{service.description}</p>
              <span class="link-arrow inline-flex items-center gap-1.5 text-[0.8125rem] font-semibold" style="color: var(--color-blue);">
                Book Now
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="py-20 md:py-28" style="background: var(--color-navy);">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(0deg, rgba(255,255,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 lg:px-10">
      <div class="text-center mb-14 reveal">
        <div class="section-label justify-center mb-3" style="color: var(--color-blue-light);"><span style="color: var(--color-blue-light);">How It Works</span></div>
        <h2 style="color: #fff;">How Your Job Gets Done</h2>
        <p class="text-[0.9375rem] leading-[1.7] max-w-md mx-auto mt-4" style="color: rgba(148, 163, 184, 0.85);">Four simple steps — no runaround, no surprises.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {steps.map((step, i) => (
          <div class={`reveal stagger-${i + 1}`}>
            <div class="card card-blue p-6 h-full">
              <span class="stat-number text-3xl leading-none">{step.number}</span>
              <h3 class="text-[0.9375rem] font-bold mt-3 mb-2" style="color: var(--color-navy);">{step.title}</h3>
              <p class="text-[0.8125rem] leading-relaxed" style="color: var(--color-text-secondary);">{step.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-12 reveal">
        <a href="/contact#booking" class="btn-primary">
          Book Your Free Quote
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 md:py-28" style="background: var(--color-slate);">
    <div class="max-w-3xl mx-auto px-6 lg:px-10">
      <div class="text-center mb-12 reveal">
        <div class="section-label justify-center mb-3">FAQ</div>
        <h2>Common Questions</h2>
      </div>
      <div class="space-y-3">
        {faqs.map((faq, i) => (
          <div class={`reveal stagger-${(i % 3) + 1} faq-item`}>
            <button class="faq-toggle w-full flex items-center justify-between px-6 py-4 text-left group cursor-pointer" aria-expanded="false" data-faq={i}>
              <span class="font-semibold text-[0.875rem] pr-4 group-hover:text-blue-600 transition-colors" style="color: var(--color-navy); font-family: var(--font-body);">{faq.question}</span>
              <div class="w-7 h-7 rounded-[3px] flex items-center justify-center shrink-0 transition-colors" style="background: var(--color-slate); color: var(--color-text-muted);">
                <svg class="faq-chevron w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </div>
            </button>
            <div class="faq-content hidden">
              <div class="px-6 pb-5 -mt-1">
                <p class="text-[0.8125rem] leading-relaxed" style="color: var(--color-text-secondary);">{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-20 md:py-28 overflow-hidden" style="background: var(--color-navy);">
    <div class="relative max-w-[600px] mx-auto px-6 lg:px-10 text-center">
      <div class="section-label justify-center mb-3 reveal" style="color: var(--color-blue-light);"><span style="color: var(--color-blue-light);">Get Started</span></div>
      <h2 class="mb-5 reveal stagger-1" style="color: #fff;">Ready to Book Your Plumber?</h2>
      <p class="text-[0.9375rem] leading-[1.75] mb-10 reveal stagger-2" style="color: rgba(148, 163, 184, 0.85);">
        Pick a time online or call us — free quote, no obligation, no call-out fee.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 reveal stagger-3">
        <a href="/contact#booking" class="btn-primary">
          Book a Plumber
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="tel:0412555178" class="btn-outline-light">
          <svg class="w-4 h-4" style="color: var(--color-amber);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call 0412 555 178
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
})}></script>

<script>
  // FAQ toggle
  document.querySelectorAll('.faq-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement;
      const chevron = button.querySelector('.faq-chevron') as HTMLElement;
      const isOpen = !content.classList.contains('hidden');

      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-chevron').forEach(c => c.classList.remove('open'));
      document.querySelectorAll('.faq-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));

      if (!isOpen) {
        content.classList.remove('hidden');
        chevron.classList.add('open');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
