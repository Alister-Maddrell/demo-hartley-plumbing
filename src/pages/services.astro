<script>
  // Before/After Slider Logic
  document.querySelectorAll('.ba-slider').forEach(slider => {
    let isDragging = false;
    const beforeEl = slider.querySelector('.ba-before') as HTMLElement;
    const handleEl = slider.querySelector('.ba-handle') as HTMLElement;

    function updatePosition(clientX: number) {
      const rect = slider.getBoundingClientRect();
      let percent = ((clientX - rect.left) / rect.width) * 100;
      percent = Math.max(0, Math.min(100, percent));
      beforeEl.style.width = `${percent}%`;
      handleEl.style.left = `${percent}%`;
    }

    slider.addEventListener('mousedown', (e) => {
      isDragging = true;
      updatePosition((e as MouseEvent).clientX);
    });
    document.addEventListener('mousemove', (e) => {
      if (isDragging) updatePosition(e.clientX);
    });
    document.addEventListener('mouseup', () => {
      isDragging = false;
    });

    slider.addEventListener('touchstart', (e) => {
      isDragging = true;
      updatePosition((e as TouchEvent).touches[0].clientX);
    }, { passive: true });
    document.addEventListener('touchmove', (e) => {
      if (isDragging) updatePosition(e.touches[0].clientX);
    });
    document.addEventListener('touchend', () => {
      isDragging = false;
    });

    // Keyboard support
    let currentPercent = 50;
    slider.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      const step = (e as KeyboardEvent).shiftKey ? 10 : 2;
      if (key === 'ArrowLeft' || key === 'ArrowDown') {
        e.preventDefault();
        currentPercent = Math.max(0, currentPercent - step);
      } else if (key === 'ArrowRight' || key === 'ArrowUp') {
        e.preventDefault();
        currentPercent = Math.min(100, currentPercent + step);
      } else if (key === 'Home') {
        e.preventDefault();
        currentPercent = 0;
      } else if (key === 'End') {
        e.preventDefault();
        currentPercent = 100;
      } else {
        return;
      }
      beforeEl.style.width = `${currentPercent}%`;
      handleEl.style.left = `${currentPercent}%`;
      slider.setAttribute('aria-valuenow', String(Math.round(currentPercent)));
    });
  });

  // FAQ Toggle Logic
  document.querySelectorAll('.faq-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const content = button.nextElementSibling as HTMLElement;
      const chevron = button.querySelector('.faq-chevron') as HTMLElement;
      const isOpen = !content.classList.contains('hidden');

      // Close all
      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('.faq-chevron').forEach(c => c.classList.remove('rotate-180'));
      document.querySelectorAll('.faq-toggle').forEach(b => b.setAttribute('aria-expanded', 'false'));

      // Toggle current
      if (!isOpen) {
        content.classList.remove('hidden');
        chevron.classList.add('rotate-180');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
