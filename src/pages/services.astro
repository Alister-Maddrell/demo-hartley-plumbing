---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const services = [
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>',
    title: 'Emergency Repairs',
    description: '24/7 response for burst pipes, blocked drains, gas leaks, and flooding. We arrive within 60 minutes across the CBD.',
    color: 'bg-red-50 text-red-600 border-red-100',
    image: 'https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=600&h=400&fit=crop',
    alt: 'Plumbing tools including pipe wrench ready for emergency repair work',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>',
    title: 'Bathroom Renovations',
    description: 'Full design and build service. We handle plumbing, tiling, waterproofing, and fixtures — from concept to completion.',
    color: 'bg-copper-50 text-copper-600 border-copper-100',
    image: 'https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=600&h=400&fit=crop',
    alt: 'Modern renovated bathroom with clean white fixtures and elegant tiling',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>',
    title: 'Commercial Plumbing',
    description: 'Maintenance contracts, new fit-outs, and compliance work for offices, restaurants, and retail spaces.',
    color: 'bg-navy-50 text-navy-600 border-navy-100',
    image: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=600&h=400&fit=crop',
    alt: 'Modern commercial office building with glass facade',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925 3.546 5.974 5.974 0 01-2.133-1.001A3.75 3.75 0 0012 18z"/></svg>',
    title: 'Hot Water Systems',
    description: 'Supply, install, and repair all brands — gas, electric, solar, and heat pump. Same-day replacements available.',
    color: 'bg-orange-50 text-orange-600 border-orange-100',
    image: 'https://images.unsplash.com/photo-1585128792020-803d29415281?w=600&h=400&fit=crop',
    alt: 'Modern hot water system unit installed in a utility area',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>',
    title: 'Drain Cleaning',
    description: 'CCTV drain inspections, high-pressure jet blasting, and root cutting for stubborn blockages.',
    color: 'bg-water-50 text-water-600 border-water-100',
    image: 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&h=400&fit=crop',
    alt: 'High-pressure water jet used for professional drain cleaning',
  },
  {
    icon: '<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0112 21 8.25 8.25 0 016.038 7.048 8.287 8.287 0 009 9.6a8.983 8.983 0 013.361-6.867 8.21 8.21 0 003 2.48z"/></svg>',
    title: 'Gas Fitting',
    description: 'Licensed gas fitters for cooktop installation, gas line repairs, leak detection, and compliance certificates.',
    color: 'bg-violet-50 text-violet-600 border-violet-100',
    image: 'https://images.unsplash.com/photo-1556909114-f6e7ad7d3136?w=600&h=400&fit=crop',
    alt: 'Gas cooktop with blue flames on a modern kitchen stovetop',
  },
];

const steps = [
  {
    number: '01',
    title: 'Call or Book',
    description: 'Reach us by phone, form, or text. We respond within minutes.',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>',
  },
  {
    number: '02',
    title: 'Free Assessment',
    description: 'We assess the job and give you a transparent, written quote. No obligation.',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15a2.25 2.25 0 012.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"/></svg>',
  },
  {
    number: '03',
    title: 'Expert Service',
    description: 'Our licensed plumbers complete the work to the highest standard, guaranteed.',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17l-5.66-5.66a8 8 0 1111.31 0l-5.65 5.66zm0 0L12 21"/></svg>',
  },
  {
    number: '04',
    title: 'Guaranteed',
    description: 'Every job comes with our workmanship guarantee. If it breaks, we fix it free.',
    icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>',
  },
];

const faqs = [
  {
    question: 'Do you charge a call-out fee?',
    answer: 'No. We provide free assessments and quotes for all standard jobs. Emergency after-hours calls may incur a service fee which we communicate upfront before dispatching.',
  },
  {
    question: 'Are you available on weekends?',
    answer: 'Yes. We work Saturdays 8am-2pm for scheduled jobs, and our emergency line is available 24/7 including Sundays and public holidays.',
  },
  {
    question: 'Do you provide written quotes?',
    answer: 'Always. Every job receives a detailed written quote before any work begins. No surprises, no hidden costs.',
  },
  {
    question: 'Are your plumbers licensed?',
    answer: "All our plumbers hold current NSW plumbing licences and are fully insured. We're happy to provide licence numbers on request.",
  },
  {
    question: 'What suburbs do you cover?',
    answer: "We're based in the CBD and cover all inner Sydney suburbs within a 15km radius. For larger commercial jobs, we service the greater Sydney metro area.",
  },
];
---

<Layout
  title="Our Services — Hartley & Co Plumbing"
  description="Comprehensive plumbing services in Sydney CBD. Emergency repairs, bathroom renovations, commercial plumbing, hot water systems, drain cleaning, and gas fitting."
>
  <!-- Page Header -->
  <section class="relative overflow-hidden bg-navy-900">
    <div class="absolute inset-0 bg-gradient-to-br from-navy-950 via-navy-900 to-navy-800"></div>
    <div class="absolute inset-0 blueprint-grid opacity-20"></div>
    <div class="absolute inset-0 pipe-lines opacity-20"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-copper-500/[0.05] rounded-full blur-[120px] -translate-y-1/3 translate-x-1/4 pointer-events-none"></div>
    <!-- Vertical pipe accent -->
    <div class="absolute top-0 left-[10%] w-px h-full bg-gradient-to-b from-transparent via-copper-500/15 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-20 md:py-28 text-center">
      <p class="section-label text-copper-400/60 mb-4">// OUR SERVICES</p>
      <div class="copper-bar mx-auto mb-6"></div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-[-0.03em] leading-[1.05] mb-5">
        What We Can Do <span class="display-heading text-[0.9em]">for You</span>
      </h1>
      <p class="text-lg md:text-xl text-navy-300 max-w-2xl mx-auto leading-relaxed">
        Comprehensive plumbing solutions for homes and businesses across Sydney.
      </p>
    </div>

    <!-- Wave divider -->
    <div class="wave-divider">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 60" preserveAspectRatio="none" fill="#FDFBF7">
        <path d="M0,40 C360,80 720,0 1080,40 C1260,60 1380,50 1440,40 L1440,60 L0,60 Z"></path>
      </svg>
    </div>
  </section>

  <!-- Service Cards -->
  <section class="py-24 md:py-36 bg-bg-cream relative">
    <div class="absolute inset-0 pipe-lines opacity-20"></div>
    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {services.map((service, i) => (
          <div class={`reveal stagger-${(i % 3) + 1} service-card group`}>
            <!-- Image -->
            <div class="h-48 overflow-hidden relative">
              <img src={service.image} alt={service.alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" width="600" height="400" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
              <!-- Large background number -->
              <span class="absolute bottom-2 right-4 text-white/[0.08] text-[80px] font-black leading-none pointer-events-none">0{i + 1}</span>
            </div>
            <!-- Content -->
            <div class="p-7 md:p-8">
              <div class:list={['w-13 h-13 rounded-xl flex items-center justify-center mb-5 border', service.color]} set:html={service.icon} />
              <h3 class="text-xl font-bold text-text-primary mb-3 tracking-tight">{service.title}</h3>
              <p class="text-text-secondary text-[15px] leading-relaxed">{service.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Our Process -->
  <section class="bg-navy-900 py-24 md:py-36 relative overflow-hidden">
    <div class="absolute inset-0 blueprint-grid opacity-15"></div>
    <div class="absolute inset-0 pipe-lines opacity-15"></div>
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-copper-500/30 to-transparent"></div>
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-copper-500/[0.04] rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="text-center mb-16 md:mb-20 reveal">
        <p class="section-label text-copper-400/60 mb-3">// HOW IT WORKS</p>
        <div class="copper-bar mx-auto mb-5"></div>
        <h2 class="text-white mb-4">Our <span class="display-heading text-[0.9em]">Process</span></h2>
        <p class="text-navy-300 text-lg max-w-md mx-auto">Simple, transparent, and designed around you.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-5">
        {steps.map((step, i) => (
          <div class={`reveal stagger-${i + 1} relative`}>
            <div class="bg-gradient-to-br from-copper-500 via-copper-600 to-navy-800 rounded-2xl border border-copper-400/20 p-7 text-center h-full shadow-[var(--shadow-copper)] hover:shadow-[0_6px_24px_rgba(200,117,51,0.4)] hover:-translate-y-1 transition-all relative overflow-hidden">
              <!-- Blue glow accent -->
              <div class="absolute bottom-0 right-0 w-32 h-32 bg-water-500/15 rounded-full blur-2xl pointer-events-none"></div>
              <!-- Step number -->
              <div class="relative text-5xl font-black text-white/15 mb-4 font-[var(--font-display)] italic">{step.number}</div>
              <div class="relative w-12 h-12 bg-navy-800/40 border border-water-400/20 rounded-xl flex items-center justify-center text-water-300 mx-auto mb-5" set:html={step.icon} />
              <h3 class="relative text-lg font-bold text-white mb-2 tracking-tight">{step.title}</h3>
              <p class="relative text-copper-100/80 text-sm leading-relaxed">{step.description}</p>
            </div>
            {i < steps.length - 1 && (
              <div class="hidden lg:flex absolute -right-3 top-1/2 -translate-y-1/2 z-10 w-6 h-6 items-center justify-center">
                <svg class="w-4 h-4 text-copper-400" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Before/After Gallery -->
  <section class="py-24 md:py-36 bg-white relative overflow-hidden">
    <div class="absolute inset-0 water-ripple"></div>
    <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="text-center mb-14 md:mb-16 reveal">
        <p class="section-label mb-3">// OUR WORK</p>
        <div class="copper-bar mx-auto mb-5"></div>
        <h2 class="text-text-primary">Before & <span class="display-heading text-[0.85em]">After</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <!-- Slider 1 -->
        <div class="reveal stagger-1 space-y-4">
          <div class="ba-slider relative aspect-[4/3] rounded-2xl overflow-hidden shadow-[var(--shadow-elevated)] cursor-col-resize select-none border border-border-light">
            <img src="https://images.unsplash.com/photo-1552321554-5fefe8c9ef14?w=600&h=450&fit=crop" alt="After: Completed bathroom renovation" class="w-full h-full object-cover" />
            <div class="ba-before absolute inset-0 overflow-hidden" style="width:50%">
              <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?w=600&h=450&fit=crop" alt="Before: Old bathroom needing renovation" class="w-full h-full object-cover" style="min-width: calc(100cqi)" />
            </div>
            <div class="ba-handle absolute top-0 bottom-0 w-0.5 bg-copper-500 shadow-lg" style="left:50%">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-gradient-to-br from-copper-500 to-copper-600 rounded-full shadow-[var(--shadow-copper)] flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
              </div>
            </div>
            <span class="absolute top-3 left-3 bg-navy-900/80 text-white text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-full backdrop-blur-sm">Before</span>
            <span class="absolute top-3 right-3 bg-white/90 text-navy-900 text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-full">After</span>
          </div>
          <p class="text-text-secondary text-sm text-center font-medium">Complete bathroom renovation — Surry Hills</p>
        </div>
        <!-- Slider 2 -->
        <div class="reveal stagger-2 space-y-4">
          <div class="ba-slider relative aspect-[4/3] rounded-2xl overflow-hidden shadow-[var(--shadow-elevated)] cursor-col-resize select-none border border-border-light">
            <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=600&h=450&fit=crop" alt="After: Repaired burst pipe" class="w-full h-full object-cover" />
            <div class="ba-before absolute inset-0 overflow-hidden" style="width:50%">
              <img src="https://images.unsplash.com/photo-1607472586893-edb57bdc0e39?w=600&h=450&fit=crop" alt="Before: Burst pipe damage" class="w-full h-full object-cover" style="min-width: calc(100cqi)" />
            </div>
            <div class="ba-handle absolute top-0 bottom-0 w-0.5 bg-copper-500 shadow-lg" style="left:50%">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-gradient-to-br from-copper-500 to-copper-600 rounded-full shadow-[var(--shadow-copper)] flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
              </div>
            </div>
            <span class="absolute top-3 left-3 bg-navy-900/80 text-white text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-full backdrop-blur-sm">Before</span>
            <span class="absolute top-3 right-3 bg-white/90 text-navy-900 text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-full">After</span>
          </div>
          <p class="text-text-secondary text-sm text-center font-medium">Emergency burst pipe repair — CBD office</p>
        </div>
        <!-- Slider 3 -->
        <div class="reveal stagger-3 space-y-4">
          <div class="ba-slider relative aspect-[4/3] rounded-2xl overflow-hidden shadow-[var(--shadow-elevated)] cursor-col-resize select-none border border-border-light">
            <img src="https://images.unsplash.com/photo-1585128792020-803d29415281?w=600&h=450&fit=crop" alt="After: New hot water system installed" class="w-full h-full object-cover" />
            <div class="ba-before absolute inset-0 overflow-hidden" style="width:50%">
              <img src="https://images.unsplash.com/photo-1585128792020-803d29415281?w=600&h=450&fit=crop&sat=-20" alt="Before: Old hot water system" class="w-full h-full object-cover" style="min-width: calc(100cqi)" />
            </div>
            <div class="ba-handle absolute top-0 bottom-0 w-0.5 bg-copper-500 shadow-lg" style="left:50%">
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-gradient-to-br from-copper-500 to-copper-600 rounded-full shadow-[var(--shadow-copper)] flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/></svg>
              </div>
            </div>
            <span class="absolute top-3 left-3 bg-navy-900/80 text-white text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-full backdrop-blur-sm">Before</span>
            <span class="absolute top-3 right-3 bg-white/90 text-navy-900 text-[10px] font-bold tracking-wider uppercase px-3 py-1.5 rounded-full">After</span>
          </div>
          <p class="text-text-secondary text-sm text-center font-medium">Hot water system replacement — Darlinghurst</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-bg-light py-24 md:py-36 relative overflow-hidden">
    <div class="absolute inset-0 pipe-lines opacity-15"></div>
    <div class="relative max-w-3xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="text-center mb-14 md:mb-16 reveal">
        <p class="section-label mb-3">// FAQ</p>
        <div class="copper-bar mx-auto mb-5"></div>
